APP_NAME=HireBee API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Option A: keep DATABASE_URL empty and use DB_* variables below
DATABASE_URL=
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
AUTO_CREATE_DATABASE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESUME_STORAGE_DIR=storage/resumes
PARSING_CONFIDENCE_THRESHOLD=0.55
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=job_skills
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
MATCHING_SCORE_THRESHOLD=0.45
MATCHING_TOP_K=8
QDRANT_SAFE_UPSERT=true
