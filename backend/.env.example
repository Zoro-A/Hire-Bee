APP_NAME=HireBee API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Option A: keep DATABASE_URL empty and use DB_* variables below
DATABASE_URL=
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
AUTO_CREATE_DATABASE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
RESUME_STORAGE_DIR=storage/resumes
PARSING_CONFIDENCE_THRESHOLD=0.55
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Conversational CV chat: openai | ollama
CONVERSATION_LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a tag from `ollama list` (e.g. llama3.2:1b). Not the same as `ollama run` without :tag if you only pulled :1b.
OLLAMA_CHAT_MODEL=llama3.2:1b
# Ollama /api/chat options (optional). If you see "llama runner process has terminated", try OLLAMA_CHAT_NUM_CTX=2048 and/or OLLAMA_CHAT_NUM_GPU=0 (CPU-only).
OLLAMA_CHAT_NUM_CTX=4096
OLLAMA_CHAT_NUM_PREDICT=512
# OLLAMA_CHAT_NUM_GPU=0
# CV JSON from transcript: openai (now); qwen_local when your fine-tuned endpoint is wired
CV_JSON_LLM_PROVIDER=openai
QWEN_LOCAL_ADAPTER_PATH=
QWEN_LOCAL_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# auto | cpu
QWEN_LOCAL_DEVICE=auto
QWEN_LOCAL_MAX_NEW_TOKENS=1400
QWEN_LOCAL_TEMPERATURE=0.15
# Conversation history persistence limits
CONVERSATION_HISTORY_LIMIT=80
CONVERSATION_HISTORY_STORE_LIMIT=300
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=job_skills
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
MATCHING_SCORE_THRESHOLD=0.45
MATCHING_TOP_K=8
QDRANT_SAFE_UPSERT=true
GENERATED_ASSETS_DIR=storage/generated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_platform_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_platform_email@gmail.com
SMTP_USE_TLS=true
GOOGLE_CLIENT_ID=
FRONTEND_BASE_URL=http://localhost:5173
